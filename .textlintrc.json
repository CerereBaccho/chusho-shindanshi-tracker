{
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": {
        "max": 100
      },
      "max-kanji-continuous-len": {
        "max": 6,
        "allow": [
          "中小企業診断士",
          "中小企業診断士試験",
          "中小企業診断協会",
          "企業経営理論期"
        ]
      },
      "no-exclamation-question-mark": true,
      "no-doubled-joshi": true,
      "no-redundant-expression": true,
      "ja-no-mixed-period": {
        "periodMark": "。"
      },
      "no-unmatched-pair": true
    },
    "no-mix-dearu-desumasu": {
      "preferInHeader": "",
      "preferInBody": "ですます",
      "preferInList": "ですます",
      "strict": false
    }
  },
  "filters": {
    "comments": true
  },
  "plugins": []
}
